import tkinter as tk
from tkinter import scrolledtext

class LeerArchivo:
    """Clase encargada de leer el contenido de un archivo de texto."""

    @staticmethod
    def leer(nombre_archivo, funcion_imprimir=print):
        """Lee línea a línea un archivo de texto y maneja excepciones de E/S."""
        try:
            with open(nombre_archivo, 'r', encoding='utf-8') as archivo:
                linea = archivo.readline()
                while linea:
                    funcion_imprimir(linea.strip())
                    linea = archivo.readline()
        except FileNotFoundError:
            funcion_imprimir("No se pudo encontrar el archivo especificado.")
        except IOError:
            funcion_imprimir("No se pudo leer el archivo.")


class InterfazLeerArchivo:
    """Interfaz gráfica para interactuar con la lectura del archivo."""

    def __init__(self, master):
        self.master = master
        master.title("Ejercicio 6.8 - Lectura de Archivos")
        master.geometry("450x480")

        tk.Label(master, text="Archivo a leer:").pack(pady=(15, 0))
        self.entry_ruta = tk.Entry(master, width=35)
        self.entry_ruta.insert(0, "prueba.txt")
        self.entry_ruta.pack(pady=5)

        self.btn_crear = tk.Button(master, text="Crear Archivo de Prueba", command=self.crear_archivo_prueba)
        self.btn_crear.pack(pady=5)

        self.btn_ejecutar = tk.Button(master, text="Leer Archivo", command=self.ejecutar_lectura)
        self.btn_ejecutar.pack(pady=10)

        self.consola = scrolledtext.ScrolledText(master, width=50, height=14, state='disabled')
        self.consola.pack(padx=10, pady=10)

    def imprimir_pantalla(self, mensaje):
        self.consola.config(state='normal')
        self.consola.insert(tk.END, mensaje + "\n")
        self.consola.see(tk.END)
        self.consola.config(state='disabled')

    def limpiar_pantalla(self):
        self.consola.config(state='normal')
        self.consola.delete('1.0', tk.END)
        self.consola.config(state='disabled')

    def crear_archivo_prueba(self):
        try:
            with open("prueba.txt", "w", encoding="utf-8") as archivo:
                for i in range(1, 11):
                    archivo.write(f"Linea {i}\n")
            self.imprimir_pantalla("Archivo 'prueba.txt' creado con éxito.")
        except Exception as e:
            self.imprimir_pantalla(f"Error al crear el archivo: {e}")

    def ejecutar_lectura(self):
        self.limpiar_pantalla()
        nombre_archivo = self.entry_ruta.get().strip()
        if not nombre_archivo:
            self.imprimir_pantalla("Por favor ingrese un nombre de archivo válido.")
            return
        LeerArchivo.leer(nombre_archivo, self.imprimir_pantalla)


if __name__ == "__main__":
    ventana = tk.Tk()
    app = InterfazLeerArchivo(ventana)
    ventana.mainloop()
